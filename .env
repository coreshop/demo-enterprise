APP_ENV=prod
APP_DEBUG=1
# demo default, override in production (Helm values / secret)
APP_SECRET=coreshop-enterprise-demo-change-me

DATABASE_USER=pimcore
DATABASE_PASSWORD=pimcore
DATABASE_NAME=pimcore
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_VERSION=8.0.26
# Pimcore 2026 configures the default connection via DATABASE_URL; built from the parts above
DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?serverVersion=${DATABASE_VERSION}&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

# Pimcore 12+ encryption secret and product registration (https://license.pimcore.com/register)
# set real values in .env.local or the deployment secret; empty values keep the installer working
PIMCORE_ENCRYPTION_SECRET=
PIMCORE_INSTANCE_IDENTIFIER=
PIMCORE_PRODUCT_KEY=

# Pimcore 2026: search index (Generic Data Index) and messenger transport
PIMCORE_OPENSEARCH_DSN=opensearch://opensearch:9200?ssl=false
PIMCORE_MESSENGER_TRANSPORT_DSN_PREFIX=doctrine://default?queue_name=

# Mercure hub for Pimcore Studio real-time updates
MERCURE_JWT_KEY=coreshop-enterprise-demo-mercure-change-me
MERCURE_URL=http://localhost/hub
MERCURE_SERVER_URL=http://mercure/.well-known/mercure

# Sentry (staging/prod config), empty = disabled
SENTRY_DSN=
