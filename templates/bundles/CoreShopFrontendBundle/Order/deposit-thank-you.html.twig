{% extends '@CoreShopFrontend/layout.html.twig' %}

{% block title %}
    {{ 'coreshop.ui.deposit_confirmation'|trans }} | {{ 'coreshop.ui.checkout'|trans }}
{% endblock %}

{% block content %}
    <div class="alert alert-success" role="alert">
        <h6 class="mb-0">{{ 'coreshop.ui.deposit_confirmation'|trans }}</h6>
        {{ 'coreshop.ui.order_deposit_successful'|trans }} {{ 'coreshop.ui.order'|trans }} {{ order.orderNumber }}
    </div>

    {% include '@CoreShopFrontend/Common/order_detail.html.twig' with {order: order} only %}
{% endblock %}
