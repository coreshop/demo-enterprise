{% extends '@CoreShopFrontend/Order/layout.html.twig' %}
{% import "@CoreShopFrontend/Common/Macro/messages.html.twig" as messages %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block checkout_title %}
    {{ 'coreshop.ui.order_deposit'|trans }}
{% endblock %}

{% block order %}
    {% include '@CoreShopFrontend/Common/order_detail.html.twig' with {order: order} only %}

    {% if order.paymentState in ['partially_paid'] %}
        <div class="card bg-light border-0 mt-3">
            <h4 class="px-3 pt-3 mb-0">
                {{ 'coreshop.ui.order_deposit'|trans }}
            </h4>
            <div class="card-body">
                {{ form_start(form, {'action': path('coreshop_order_deposit', {'token': order.token}), 'attr': {'novalidate': 'novalidate'}}) }}
                {{ form_errors(form) }}

                <div class="form-group">
                    {{ form_widget(form.paymentProvider, coreshop_test_form_attribute('select-payment-provider'), {attr: {class: 'form-select'}}) }}
                </div>

                <div class="paymentSettings">
                    {% if form.paymentSettings is defined %}
                        {% for field in form.paymentSettings %}
                            {{ form_row(field) }}
                        {% endfor %}
                    {% endif %}
                </div>

                {% for name, paymentSettingConfigurationPrototype in form.vars.prototypes %}
                    <div id="{{ form.paymentProvider.vars.id }}_{{ name }}" data-container=".configuration"
                         data-prototype="{{ form_widget(paymentSettingConfigurationPrototype)|e }}">
                    </div>
                {% endfor %}

                <div class="d-flex pt-3">
                    {{ form_widget(form.submitPayment, {label: 'coreshop.form.order.deposit.submit_payment'|trans, attr: {class: 'btn btn-primary ms-auto'}}) }}
                </div>

                {{ form_end(form, {'render_rest': false}) }}
            </div>
        </div>
    {% else %}
        {{ messages.info('coreshop.ui.order_deposit_payment_not_allowed') }}
    {% endif %}
{% endblock %}
